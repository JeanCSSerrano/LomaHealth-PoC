/* Pure CSS Donut Chart! */
.css-donut-chart {
    width: 320px;        /* Increased from 220px */
    height: 320px;       /* Increased from 220px */
    border-radius: 50%;
    /* Colors mimic the image: teal, blue, red, yellow */
    background: conic-gradient(
        #7dd3fc 0% 25%, 
        #ef4444 25% 60%, 
        #fcd34d 60% 80%, 
        #5eead4 80% 100%
    );
    margin: 60px auto;   /* Increased margin to center it better vertically */
    position: relative;
}

/* The white center circle to make it a donut */
.css-donut-chart::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 170px;        /* Increased from 120px to keep the donut thickness balanced */
    height: 170px;       /* Increased from 120px */
    background-color: white;
    border-radius: 50%;
}

