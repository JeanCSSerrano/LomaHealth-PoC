<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Auth - LomaHealth</title>
    <link rel="stylesheet" href="assets/style.css">
</head>
<body class="auth-body">

    <!-- Left Side: Branding & Info -->
    <div class="auth-left">
        <!-- Decorative Background Circles -->
        <div class="circle circle-1"></div>
        <div class="circle circle-2"></div>
        <div class="circle circle-3"></div>

        <div class="auth-brand-top">
            <img src="assets/images/Lomahealth_logo.png" alt="Logo">
            <span>LomaHealth</span>
        </div>

        <div class="auth-hero-text">
            <h1>Barangay Health<br>Management System</h1>
            <p>Integrated health records, immunization tracking, and predictive analytics for Barangay Loma de Gato</p>
        </div>

        <div class="auth-footer">
            <small>© 2026 Barangay Loma de Gato Health Center</small>
        </div>
    </div>

    <!-- Right Side: Forms -->
    <div class="auth-right">
        <div class="auth-form-container">
            
            <!-- Header Logo (Visible on mobile/right side) -->
            <div class="auth-right-header">
                <img src="assets/images/Lomahealth_logo.png" alt="Logo">
                <h2>LomaHealth</h2>
            </div>
            <p class="auth-subtitle">Smarter Health, Healthier Communities</p>

            <!-- Toggle Pill -->
            <div class="auth-toggle">
                <div class="toggle-btn active" id="btn-login" onclick="switchForm('login')">Log in</div>
                <div class="toggle-btn" id="btn-register" onclick="switchForm('register')">Register</div>
            </div>

            <!-- ============================== -->
            <!-- LOGIN FORM -->
            <!-- ============================== -->
            <div id="login-form">
                <h2 class="form-title">Welcome back</h2>
                <p class="form-desc">Log in with your resident account to manage appointments.</p>
                
                <div class="auth-input-group">
                    <label>Email Address</label>
                    <div class="input-with-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
                        <!-- We will use email as our fake routing trigger -->
                        <input type="text" id="login-email" placeholder="Enter your email">
                    </div>
                </div>
                
                <div class="auth-input-group">
                    <label>Password</label>
                    <div class="input-with-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <input type="password" placeholder="Enter your password">
                    </div>
                </div>

                <button class="auth-submit-btn" onclick="handleLogin()">Sign In</button>
                <div class="forgot-link">
                    <a href="#">Forgot password?</a>
                </div>
            </div>

            <!-- ============================== -->
            <!-- REGISTER FORM (Hidden by default) -->
            <!-- ============================== -->
            <div id="register-form" style="display: none;">
                <h2 class="form-title" style="margin-bottom: 20px;">Create your account</h2>
                
                <div class="register-grid">
                    <div class="auth-input-group">
                        <label>First name</label>
                        <input type="text">
                    </div>
                    <div class="auth-input-group">
                        <label>Last name</label>
                        <input type="text">
                    </div>
                    <div class="auth-input-group">
                        <label>Date of Birth</label>
                        <input type="date">
                    </div>

                    <div class="auth-input-group col-2">
                        <label>Email</label>
                        <input type="email">
                    </div>
                    <div class="auth-input-group">
                        <label>Sex</label>
                        <input type="text">
                    </div>

                    <div class="auth-input-group full-width">
                        <label>Address</label>
                        <input type="text">
                    </div>

                    <div class="auth-input-group full-width">
                        <label>Barangay Extension</label>
                        <input type="text" value="Proper / Main Barangay Hall" readonly>
                    </div>

                    <div class="auth-input-group full-width">
                        <label>Mobile number</label>
                        <input type="text">
                    </div>

                    <div class="auth-input-group full-width">
                        <label>Create password</label>
                        <input type="password">
                    </div>
                </div>

                <div class="terms-check">
                    <small>I agree to the Terms of Service and Privacy Policy</small>
                </div>

                <button class="auth-submit-btn">Create an account</button>
            </div>

        </div>
    </div>

    <!-- JavaScript to handle the toggle and the fake login -->
    <script>
        function switchForm(formType) {
            // Get elements
            const loginForm = document.getElementById('login-form');
            const regForm = document.getElementById('register-form');
            const btnLogin = document.getElementById('btn-login');
            const btnReg = document.getElementById('btn-register');

            if (formType === 'login') {
                loginForm.style.display = 'block';
                regForm.style.display = 'none';
                btnLogin.classList.add('active');
                btnReg.classList.remove('active');
            } else {
                loginForm.style.display = 'none';
                regForm.style.display = 'block';
                btnReg.classList.add('active');
                btnLogin.classList.remove('active');
            }
        }

// Mock Login Routing
function handleLogin() {
            const emailInput = document.getElementById('login-email').value.toLowerCase().trim();
            
            if (emailInput.includes('resident')) {
                window.location.href = 'resident/index.html';
            } else if (emailInput.includes('bhw')) {
                window.location.href = 'bhw/index.html'; 
            } else if (emailInput.includes('admin')) {
                window.location.href = 'admin/index.html'; 
            } else if (emailInput.includes('bho')) {
                window.location.href = 'bho/index.html'; 
            } else {
                alert('For this PoC, type an email containing "resident", "bhw", "admin", or "bho" to continue!');
            }
        }
    </script>
</body>
</html>
